# Copy to .env for LOCAL runs only. Never commit .env.
# On GitHub, put these under Settings > Secrets and variables > Actions.

# Gmail (use an App Password, not your normal password; 2-step verification must be on)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Where the digest goes. Defaults to GMAIL_USER if empty.
MAIL_TO=

# Free-tier LLM keys. Set at least one; they are tried in the order given in config.yaml.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional: cleaner search results than DuckDuckGo
TAVILY_API_KEY=
